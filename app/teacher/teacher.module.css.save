.page {
  min-height: 100vh;
  background: #eef7fb;
  padding: 30px;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.header h1 {
  margin: 0;
  color: #123b5d;
  font-size: 32px;
  font-weight: 700;
}

.header p {
  margin: 7px 0 0;
  color: #6b8799;
  font-size: 14px;
}

.profile {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #fff;
  border: 1px solid #d8eaf2;
  border-radius: 12px;
  padding: 10px 14px;
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1d6f9f;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
}

.profileName {
  color: #123b5d;
  font-size: 13px;
  font-weight: 700;
}

.profileRole {
  margin-top: 2px;
  color: #6b8799;
  font-size: 11px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 22px;
}

.statCard {
  background: #fff;
  border: 1px solid #d8eaf2;
  border-radius: 14px;
  padding: 20px;
  box-shadow: 0 2px 10px rgba(18, 59, 93, 0.05);
}

.statLabel {
  color: #6b8799;
  font-size: 12px;
  font-weight: 600;
}

.statValue {
  margin-top: 8px;
  color: #123b5d;
  font-size: 28px;
  font-weight: 700;
}

.grid {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
  gap: 22px;
}

.panel {
  background: #fff;
  border: 1px solid #d8eaf2;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(18, 59, 93, 0.05);
}

.panelHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 20px;
  border-bottom: 1px solid #e5f0f5;
}

.panelHeader h2 {
  margin: 0;
  color: #123b5d;
  font-size: 19px;
  font-weight: 700;
}

.panelHeader p {
  margin: 5px 0 0;
  color: #6b8799;
  font-size: 12px;
}

.count {
  background: #edf7fb;
  color: #39718d;
  border: 1px solid #d7ebf3;
  border-radius: 20px;
  padding: 6px 11px;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.scheduleList {
  padding: 14px;
}

.scheduleItem {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
  border: 1px solid #e5f0f5;
  border-radius: 10px;
  margin-bottom: 10px;
  transition: 0.15s;
}

.scheduleItem:last-child {
  margin-bottom: 0;
}

.scheduleItem:hover {
  border-color: #a9d5e5;
  background: #fafdff;
}

.dateBox {
  width: 58px;
  min-width: 58px;
  text-align: center;
  background: #edf7fb;
  border: 1px solid #d7ebf3;
  border-radius: 10px;
  padding: 9px 5px;
}

.dateDay {
  color: #123b5d;
  font-size: 20px;
  font-weight: 700;
}

.dateMonth {
  margin-top: 2px;
  color: #52758a;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
}

.classInfo {
  min-width: 0;
  flex: 1;
}

.studentName {
  color: #123b5d;
  font-size: 15px;
  font-weight: 700;
}

.courseName {
  margin-top: 4px;
  color: #39718d;
  font-size: 12px;
}

.classTime {
  margin-top: 5px;
  color: #6b8799;
  font-size: 12px;
}

.status {
  display: inline-block;
  background: #e3f4fb;
  color: #16709c;
  border: 1px solid #c9e8f3;
  border-radius: 20px;
  padding: 5px 9px;
  font-size: 10px;
  font-weight: 700;
}

.empty {
  margin: 14px;
  padding: 35px 20px;
  text-align: center;
  background: #f8fcfe;
  border: 1px dashed #cfe4ed;
  border-radius: 10px;
  color: #6b8799;
  font-size: 13px;
}

.actions {
  display: grid;
  gap: 10px;
  padding: 14px;
}

.action {
  display: block;
  padding: 15px;
  border: 1px solid #d8eaf2;
  border-radius: 10px;
  background: #fafdff;
  text-decoration: none;
  transition: 0.15s;
}

.action:hover {
  background: #edf7fb;
  border-color: #a9d5e5;
}

.actionTitle {
  color: #1d5d83;
  font-size: 13px;
  font-weight: 700;
}

.actionText {
  margin-top: 4px;
  color: #6b8799;
  font-size: 11px;
}

.error {
  margin-bottom: 20px;
  padding: 12px 15px;
  border: 1px solid #fed7d7;
  border-radius: 10px;
  background: #fff5f5;
  color: #c53030;
  font-size: 13px;
}

@media (max-width: 1000px) {
  .stats {
    grid-template-columns: 1fr;
  }

  .grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .page {
    padding: 18px;
  }

  .header {
    display: block;
  }

  .header h1 {
    font-size: 27px;
  }

  .profile {
    margin-top: 18px;
  }

  .scheduleItem {
    align-items: flex-start;
  }

  .status {
    display: none;
  }
}
.dashboard {
  min-height: 100vh;
  display: flex;
  background: #eef7fb;
}

.sidebar {
  width: 245px;
  flex-shrink: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #123b5d;
  color: #fff;
  padding: 20px 14px;
  box-sizing: border-box;
}

.logoArea {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 8px 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.logo {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1d6f9f;
  color: #fff;
  font-size: 13px;
  font-weight: 800;
}

.logoTitle {
  font-size: 14px;
  font-weight: 700;
}

.logoSubtitle {
  margin-top: 2px;
  color: #a9d5e5;
  font-size: 10px;
}

.nav {
  display: grid;
  gap: 6px;
  margin-top: 24px;
}

.navItem {
  display: flex;
  align-items: center;
  gap: 11px;
  min-height: 44px;
  padding: 0 12px;
  border-radius: 8px;
  color: #d9edf5;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  transition: 0.15s;
}

.navItem span {
  width: 20px;
  text-align: center;
  font-size: 15px;
}

.navItem:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}

.activeNav {
  background: #1d6f9f;
  color: #fff;
}

.sidebarBottom {
  margin-top: auto;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.teacherMini {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
}

.miniName {
  color: #fff;
  font-size: 12px;
  font-weight: 700;
}

.miniRole {
  margin-top: 2px;
  color: #a9d5e5;
  font-size: 10px;
}

.logoutButton {
  width: 100%;
  min-height: 42px;
  margin-top: 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 12px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  background: transparent;
  color: #d9edf5;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
  text-align: left;
}

.logoutButton:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}

.main {
  flex: 1;
  min-width: 0;
  padding: 30px;
  box-sizing: border-box;
}

@media (max-width: 800px) {
  .dashboard {
    display: block;
  }

  .sidebar {
    width: 100%;
    min-height: auto;
    padding: 14px;
  }

  .logoArea {
    padding-bottom: 14px;
  }

  .nav {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 14px;
  }

  .sidebarBottom {
    margin-top: 14px;
    padding-top: 14px;
  }

  .main {
    padding: 18px;
  }
}

@media (max-width: 500px) {
  .nav {
    grid-template-columns: 1fr;
  }
}
